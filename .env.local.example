# Emocio environment configuration (example)
# Copy this file to .env.local and fill in your values.
# Do NOT commit .env.local with real secrets.

# Firebase configuration
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_DATABASE_URL=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Mapbox access token
REACT_APP_MAPBOX_TOKEN=

# Optional: collection names (if you refactor config.js to read from env)
# REACT_APP_FB_FEEDS=publicEmocio
# REACT_APP_FB_HASHTAGS=publicHashtags

# Notes:
# - Create React App exposes env vars prefixed with REACT_APP_ at build time.
# - After setting these variables, update src/config.js and src/components/EmotionMap.js
#   to read from process.env (recommended) instead of hard-coding values.
# - Rotate any previously exposed keys and restrict usage per environment.
