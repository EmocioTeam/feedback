# Emocio — Firebase environment variables (example)
# Copy this file to .env.local and fill with your Firebase project/app values.
# Note: Never commit .env.local; it should remain local only.

# Firebase Web App configuration
REACT_APP_FIREBASE_API_KEY=your-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
# Storage bucket must be "<project-id>.appspot.com"
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
REACT_APP_FIREBASE_APP_ID=your-app-id
REACT_APP_MEASUREMENT_ID=your-measurement-id

# Image storage mode:
# - Omit or set to "storage" to use Firebase Storage (requires Storage enabled and CORS set)
# - Set to "base64" to embed images as data URLs in Firestore (no Storage plan required)
#   Example for environments without Firebase Storage:
REACT_APP_PICTURE_MODE=base64

# Firestore collections (defaults retained if not set)
REACT_APP_FB_FEEDS=publicEmocio
REACT_APP_FB_HASHTAGS=publicHashtags
